# =============================================================================
# QuantHub -- example environment configuration
# Copy to .env (which is gitignored) and fill in real values for local dev.
# =============================================================================

# Which LLM backend powers /api/v1/explain.
#   gemini -> Google gemini-2.5-flash (needs GEMINI_API_KEY)
#   local  -> deterministic offline templates, no API key required
# If unset, the server auto-picks: gemini when GEMINI_API_KEY is present,
# otherwise local.
LLM_PROVIDER=gemini

# Google AI Studio API key for the Gemini provider.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Wolfram credentials for Research Mode verification.
# These are server-side only. Do not expose them as VITE_* variables.
WOLFRAM_APP_ID=
WOLFRAM_API_KEY=

# Featherless AI key for the server-side QuantHub chat assistant.
# Never expose this as a VITE_* variable.
FEATHERLESS_API_KEY=
# Optional model override. Defaults to deepseek-ai/DeepSeek-V4-Flash.
# FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Optional: override the Gemini model id (default: gemini-2.5-flash).
# QUANTUMLAB_GEMINI_MODEL=gemini-2.5-pro

# Comma-separated browser origins allowed to call the FastAPI service.
# Example production value: https://your-vercel-app.vercel.app
CORS_ORIGINS=http://127.0.0.1:5173

# Frontend backend URL. In production, set this in Vercel to your deployed
# FastAPI service URL.
VITE_API_URL=http://127.0.0.1:8765

# Firebase client config. These values are public Firebase identifiers, not
# service-account secrets. Keep real values in .env or your hosting provider.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# QuantHub platform (projects, experiments, runs)
# -----------------------------------------------------------------------------
# Deployment environment: development | test | production.
# Unset means "unspecified": treated as non-development, so unverified identity
# headers are ignored and production-like checks apply. Set it explicitly.
# QUANTHUB_ENV=development

# Directory holding the SQLite database, bare Git repositories and run artifacts.
# The database is derived state: it is created and migrated on first start and
# must not be committed to source control.
QUANTHUB_DATA_DIR=./.quanthub-data
# Optional explicit database file (defaults to <data>/quanthub.sqlite3).
# QUANTHUB_DB_PATH=./.quanthub-data/quanthub.sqlite3

# Local development: scripts/dev-api.sh sets the two variables below for you.
# Development only: accept X-QuantHub-User / -Name / -Email identity headers.
# Requires QUANTHUB_ENV=development (or test). Startup fails if this is enabled
# in production or while QUANTHUB_ENV is unset. NEVER enable it on a public
# deployment: anyone could claim any identity.
# QUANTHUB_TRUST_CLIENT_IDENTITY=1

# Experiment execution limits.
# QUANTHUB_RUN_TIMEOUT_SECONDS=900
# QUANTHUB_MAX_CONCURRENT_RUNS=2

# Optional comma-separated RSS/Atom feeds for the live community news rail.
# When empty (or unreachable) the app shows the curated, individually verified
# snapshot and labels it as such.
# QUANTHUB_NEWS_FEEDS=https://example.org/feed.xml
# QUANTHUB_NEWS_TTL_SECONDS=900

# Firebase Admin project id (backend only) enables bearer-token verification.
# The canonical variable is FIREBASE_PROJECT_ID; GOOGLE_CLOUD_PROJECT is accepted
# as a fallback and QUANTHUB_FIREBASE_PROJECT as a deprecated alias. VITE_* vars
# are frontend-only and are never used to verify tokens server-side.
# Required when QUANTHUB_ENV=production.
# FIREBASE_PROJECT_ID=

# Development: Vite proxies /api to this origin. Must be a server-side variable.
# VITE_API_PROXY=http://127.0.0.1:8765
