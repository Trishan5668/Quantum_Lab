# =============================================================================
# QuantumLab -- example environment configuration
# Copy to .env (which is gitignored) and fill in real values for local dev.
# =============================================================================

# Which LLM backend powers /api/v1/explain.
#   gemini -> Google gemini-2.5-flash (needs GEMINI_API_KEY)
#   local  -> deterministic offline templates, no API key required
# If unset, the server auto-picks: gemini when GEMINI_API_KEY is present,
# otherwise local.
LLM_PROVIDER=gemini

# Google AI Studio API key for the Gemini provider.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Wolfram credentials for Research Mode verification.
# These are server-side only. Do not expose them as VITE_* variables.
WOLFRAM_APP_ID=
WOLFRAM_API_KEY=

# Featherless AI key for the server-side QuantumLab chat assistant.
# Never expose this as a VITE_* variable.
FEATHERLESS_API_KEY=
# Optional model override. Defaults to deepseek-ai/DeepSeek-V4-Flash.
# FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Optional: override the Gemini model id (default: gemini-2.5-flash).
# QUANTUMLAB_GEMINI_MODEL=gemini-2.5-pro

# Comma-separated browser origins allowed to call the FastAPI service.
# Example production value: https://your-vercel-app.vercel.app
CORS_ORIGINS=http://127.0.0.1:5173

# Frontend backend URL. In production, set this in Vercel to your deployed
# FastAPI service URL.
VITE_API_URL=http://127.0.0.1:8765

# Firebase client config. These values are public Firebase identifiers, not
# service-account secrets. Keep real values in .env or your hosting provider.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
