{
  "name": "@quantumlab/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "QuantumLab Electron shell.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.quantumlab.desktop",
    "productName": "QuantumLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "../webapp/dist/**/*"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
